{
  "name": "studydeck-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build -w @studydeck/shared && npm run dev -w @studydeck/web",
    "dev:web": "npm run dev -w @studydeck/web",
    "dev:web:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-web-fast.ps1",
    "dev:api": "npm run dev -w @studydeck/api",
    "dev:worker": "npm run dev -w @studydeck/worker",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run build -w @studydeck/shared && npm run typecheck -w @studydeck/shared && npm run typecheck -w @studydeck/api && npm run typecheck -w @studydeck/web && npm run typecheck -w @studydeck/worker",
    "lint": "node scripts/verify-lint-baseline.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "smoke:generation:live": "tsx scripts/live-generation-smoke.ts",
    "smoke:generation:dry-run": "tsx scripts/live-generation-smoke.ts --dry-run",
    "typecheck:smoke:generation": "tsc -p scripts/tsconfig.json",
    "validate:production-config": "tsx scripts/validate-production-config.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "legacy:start": "node server.js",
    "legacy:check": "node --check server.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.8",
    "@aws-sdk/client-s3": "^3.726.0",
    "@aws-sdk/s3-request-presigner": "^3.726.0",
    "@bull-board/api": "^6.7.10",
    "@bull-board/express": "^6.7.10",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.8",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.8",
    "@nestjs/platform-express": "^11.0.8",
    "@auth/prisma-adapter": "^2.11.3",
    "@auth/core": "file:packages/authjs-core",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@prisma/client": "^6.2.1",
    "@sentry/nextjs": "^10.64.0",
    "@sentry/node": "^10.64.0",
    "@stripe/stripe-js": "^5.5.0",
    "ai": "^7.0.16",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.7.3",
    "ioredis": "^5.4.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "next": "^16.3.0",
    "@studydeck/auth": "file:packages/authjs",
    "openai": "^6.10.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "@studydeck/pptxgenjs": "file:packages/pptxgenjs",
    "prisma": "^6.2.1",
    "puppeteer-core": "^25.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.61.1"
  }
}
