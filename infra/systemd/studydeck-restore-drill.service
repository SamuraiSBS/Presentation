[Unit]
Description=StudyDeck isolated restore drill
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=studydeck
Group=studydeck
WorkingDirectory=/opt/studydeck/current
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/studydeck/backups
ExecStart=/usr/bin/env bash /opt/studydeck/current/scripts/restore-drill.sh --root /opt/studydeck --env-file .env.production
