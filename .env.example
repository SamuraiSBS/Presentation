NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000

# Web / Auth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="StudyDeck AI <noreply@example.com>"
ALLOW_DEV_AUTH=false
NEXT_PUBLIC_ALLOW_DEV_AUTH=false

# Internal service boundary
INTERNAL_API_URL=http://localhost:4000
INTERNAL_API_TOKEN=change-me-internal-token

# Database, queue and object storage
DATABASE_URL=postgresql://studydeck:studydeck@localhost:5432/studydeck?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=studydeck
S3_ACCESS_KEY_ID=studydeck
S3_SECRET_ACCESS_KEY=studydeck-password
S3_FORCE_PATH_STYLE=true

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STUDENT=
STRIPE_PRICE_PRO=

# Service ports
WEB_PORT=3000
API_PORT=4000
