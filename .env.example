NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000

# Web / Auth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="StudyDeck AI <noreply@example.com>"
ALLOW_DEV_AUTH=false
TEMP_USER_ID=local-user

# Admin access. Keep ALLOW_DEV_ADMIN=false in production. ADMIN_TELEGRAM_IDS is
# a comma-separated allowlist of immutable Telegram IDs, never usernames.
ALLOW_DEV_ADMIN=false
ADMIN_TELEGRAM_IDS=
DEPLOYMENT_ENV=local

# Internal service boundary
INTERNAL_API_URL=http://localhost:4000
INTERNAL_API_TOKEN=change-me-internal-token

# Database, queue and object storage
DATABASE_URL=postgresql://studydeck:studydeck@localhost:5432/studydeck?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=studydeck
S3_ACCESS_KEY_ID=studydeck
S3_SECRET_ACCESS_KEY=studydeck-password
S3_FORCE_PATH_STYLE=true

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Optional OpenAI-compatible gateway. For AITUNNEL set this to
# https://api.aitunnel.ru/v1/ and use its sk-aitunnel-* key above.
OPENAI_BASE_URL=
# AITUNNEL is a separate, explicitly selected provider. Set AI_PROVIDER=aitunnel
# and keep the model explicit (never "auto"); never commit a real key.
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
AITUNNEL_NARRATION_MODEL=gpt-5.6-terra
# Luna is the default for every regular stage. Terra is reserved for the
# final presentation JSON and a complete narration rewrite.
AITUNNEL_ECONOMY_MODEL=gpt-5.6-luna
# Deprecated compatibility setting. The strict standard-generation policy is
# persisted per run and capped at 10 RUB; this value is not its source of truth.
# Fixed buckets: sources 0.50, narration candidate 4.00, hidden narration
# fallback 4.00, images 0.50, export/infra 1.00 RUB. Change only in the
# versioned shared policy so the stored policy and catalog snapshots agree.
AITUNNEL_PROJECT_BUDGET_RUB=12
# Per narration job; includes the Terra complete-rewrite reserve.
AITUNNEL_NARRATION_JOB_BUDGET_RUB=10
AITUNNEL_NARRATION_MAX_OUTPUT_TOKENS=2400
AITUNNEL_NARRATION_REASONING_EFFORT=minimal
# Optional image understanding for uploaded defense screenshots. Leave empty
# to use the deterministic metadata-only classifier.
VISION_PROVIDER=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL_URI=
YANDEX_MODEL_NAME=yandexgpt
# Optional explicit A/B candidate for narration and its recovery calls only.
# Leave blank to preserve the primary yandexgpt/latest route.
YANDEX_NARRATION_MODEL_URI=
YANDEX_NARRATION_MODEL_NAME=
# Lite is used for narrative planning, the design brief, and quality critique.
# Explicit URIs prevent a provider alias from changing the billed model silently.
YANDEX_ECONOMY_MODEL_URI=
YANDEX_ECONOMY_MODEL_NAME=yandexgpt-5-lite
TAVILY_API_KEY=
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_MAX_RESULTS=6
# Optional server-side tokens used only to raise public GitHub/GitLab API rate
# limits while reading allowlisted README/docs files. They are never sent to the web client.
GITHUB_PUBLIC_TOKEN=
GITLAB_PUBLIC_TOKEN=
PRESENTATION_IMAGES_ENABLED=true
PRESENTATION_IMAGE_MAX_BYTES=5000000
PRESENTATION_IMAGE_TIMEOUT_MS=8000
ALLOW_DEMO_GENERATION=false

# Versioned cost inputs. OpenAI gpt-5.5/gpt-5 prices are catalogued in code
# with an effective date. Provider-specific prices without a verified catalog
# remain unknown until configured instead of being reported as zero.
YANDEX_INPUT_PRICE_RUB_PER_MILLION=
YANDEX_OUTPUT_PRICE_RUB_PER_MILLION=
YANDEX_PRICING_VERSION=
YANDEX_PRICE_EFFECTIVE_FROM=
TAVILY_CREDIT_PRICE_USD=
STORAGE_PRICE_USD_PER_BYTE_MONTH=
EXPORT_COMPUTE_PRICE_RUB=
# Ready and failed export records/objects are removed by the maintenance worker
# after this many days. The quota is enforced before a newly-rendered object is uploaded.
EXPORT_RETENTION_DAYS=30
EXPORT_STORAGE_QUOTA_BYTES_PER_PROJECT=536870912

# Economic standard generation is fixed in the shared policy: 10 slides,
# source snapshot (3–4 Tavily sources), one approved AI Tunnel narration plus
# at most one fallback, and no more than two Tavily image searches. The policy
# cap is 10 RUB; do not override it with an environment variable. Leave an
# unknown provider price empty so telemetry records it as unknown, never zero.
# Approved AI Tunnel model ids are gpt-5.6-luna and gpt-5.6-terra.

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Product analytics uses PostHog's Capture API directly (no presentation text,
# source text, file names, email addresses, secrets, or prompt content).
# Leave blank to disable delivery while keeping the app fully functional.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
OTEL_TRACING_ENABLED=false
# Local foundation only: when enabled, API and worker emit safe spans to stdout.
# Wire an OTLP collector later before using this in production.
OTEL_TRACES_EXPORTER=console

# Production-only operational alerts
ADMIN_ALERTS_ENABLED=false
ADMIN_TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
ADMIN_DAILY_COST_ALERT_RUB=
ADMIN_ERROR_BURST_THRESHOLD=
# API-side probe monitoring. Alerts are production-only and use the Telegram
# channel above; the API monitors so a stopped worker can still be reported.
HEALTH_ALERT_INTERVAL_MS=60000
HEALTH_ALERT_REMINDER_MS=900000
HEALTH_QUEUE_LAG_MAX_AGE_MS=300000
HEALTH_QUEUE_WAITING_MAX=20
ADMIN_STUCK_JOB_MINUTES=30

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STUDENT=
STRIPE_PRICE_PRO=

# Service ports
WEB_PORT=3000
API_PORT=4000
