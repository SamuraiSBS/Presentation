FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS base
ARG ALPINE_SECURITY_REFRESH=20260902
ARG NPM_REGISTRY=https://registry.npmjs.org/
ENV NPM_CONFIG_REGISTRY=$NPM_REGISTRY
ENV NPM_CONFIG_REPLACE_REGISTRY_HOST=always
RUN apk upgrade --no-cache && printf '%s\n' "$ALPINE_SECURITY_REFRESH" >/dev/null
WORKDIR /app
COPY package*.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/authjs/package.json packages/authjs/package.json
COPY packages/authjs-core/package.json packages/authjs-core/package.json
COPY packages/pptxgenjs/package.json packages/pptxgenjs/package.json
RUN --mount=type=cache,target=/root/.npm npm ci
COPY prisma ./prisma
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY packages/pptxgenjs ./packages/pptxgenjs
COPY apps/worker ./apps/worker
RUN npm run prisma:generate
RUN npm run build -w @studydeck/shared
RUN npm run build -w @studydeck/worker

FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runner
ARG ALPINE_SECURITY_REFRESH=20260902
RUN apk upgrade --no-cache && printf '%s\n' "$ALPINE_SECURITY_REFRESH" >/dev/null
WORKDIR /app
ENV NODE_ENV=production
ENV CHROMIUM_PATH=/usr/bin/chromium-browser
RUN apk add --no-cache chromium font-liberation font-noto ttf-dejavu poppler-utils \
    && apk upgrade --no-cache
COPY --chown=node:node --from=base /app/package*.json ./
COPY --from=base /app/apps/web/package.json apps/web/package.json
COPY --from=base /app/apps/api/package.json apps/api/package.json
COPY --from=base /app/apps/worker/package.json apps/worker/package.json
COPY --from=base /app/packages/shared/package.json packages/shared/package.json
COPY --from=base /app/packages/authjs/package.json packages/authjs/package.json
COPY --from=base /app/packages/authjs-core/package.json packages/authjs-core/package.json
COPY --from=base /app/packages/pptxgenjs/package.json packages/pptxgenjs/package.json
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --ignore-scripts --no-audit --no-fund
# Runtime worker execution is direct Node.js; omit the package manager from the image.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
COPY --chown=node:node --from=base /app/node_modules/.prisma ./node_modules/.prisma
COPY --chown=node:node --from=base /app/prisma ./prisma
COPY --chown=node:node --from=base /app/packages/shared ./packages/shared
COPY --chown=node:node --from=base /app/packages/pptxgenjs ./packages/pptxgenjs
COPY --chown=node:node --from=base /app/apps/worker ./apps/worker
# This fixture is imported during Vitest discovery, including targeted export
# smokes run inside the immutable worker image.
COPY --chown=node:node e2e-237-accepted-speech.txt ./e2e-237-accepted-speech.txt
USER node
CMD ["node", "apps/worker/dist/main.js"]
