FROM node:22-alpine AS base
WORKDIR /app
COPY package*.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN --mount=type=cache,target=/root/.npm npm ci

# Prisma generation only depends on the schema. Keeping it before application
# sources prevents ordinary UI edits from invalidating this layer.
COPY prisma ./prisma
RUN npm run prisma:generate

COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
RUN npm run build -w @studydeck/shared
COPY apps/web ./apps/web

# Reuse Next.js' compiler cache across production image rebuilds.
RUN --mount=type=cache,target=/app/apps/web/.next/cache \
    npm run build -w @studydeck/web

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=base /app/apps/web/.next/standalone ./
COPY --from=base /app/apps/web/.next/static ./apps/web/.next/static
# Next's standalone output intentionally excludes public assets. Copy them
# explicitly so landing-page photographs remain available in the web image.
COPY --from=base /app/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
