# Copy this file to .env.production only on the deployment host. It is a
# schema, not a runnable environment: replace every placeholder with a unique
# secret from your secret manager. Never use .env.example for production.
NODE_ENV=production
DEPLOYMENT_ENV=production

# Public HTTPS hostname. Caddy obtains and renews TLS for this exact hostname.
SITE_DOMAIN=app.example.com
NEXTAUTH_URL=https://app.example.com
PUBLIC_APP_URL=https://app.example.com
NEXTAUTH_SECRET=<set-a-unique-secret-in-your-secret-manager>

# Real login is mandatory; no local fallback identity exists in production.
TELEGRAM_CLIENT_ID=REPLACE_WITH_TELEGRAM_CLIENT_ID
TELEGRAM_CLIENT_SECRET=REPLACE_WITH_TELEGRAM_CLIENT_SECRET
ALLOW_DEV_AUTH=false
ALLOW_DEV_ADMIN=false
ADMIN_TELEGRAM_IDS=123456789

# Internal web-to-API boundary. Generate independently from NEXTAUTH_SECRET.
INTERNAL_API_TOKEN=<set-a-separate-secret-in-your-secret-manager>
INTERNAL_API_URL=http://api:4000

# Perimeter security. Caddy is the only trusted proxy hop; HSTS is enabled
# only for this verified public HTTPS domain.
TRUST_PROXY_HOPS=1
HSTS_MAX_AGE=31536000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_IP_MULTIPLIER=3
API_RATE_LIMIT_UPLOAD_MAX=12
API_RATE_LIMIT_GENERATION_MAX=6
API_RATE_LIMIT_EXPORT_MAX=12
API_RATE_LIMIT_INVITE_MAX=20
API_RATE_LIMIT_BILLING_MAX=10

# Every upload is streamed to the private ClamAV daemon before object storage.
# Keep this enabled in production; a scanner outage fails uploads closed.
MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# Database and object storage. Use generated, non-default credentials.
POSTGRES_DB=studydeck
POSTGRES_USER=studydeck_app
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_32_PLUS_CHARACTER_DATABASE_SECRET
DATABASE_URL=postgresql://studydeck_app:REPLACE_WITH_A_UNIQUE_32_PLUS_CHARACTER_DATABASE_SECRET@postgres:5432/studydeck?schema=public
REDIS_URL=redis://redis:6379
MINIO_ROOT_USER=studydeck_production_root
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_UNIQUE_32_PLUS_CHARACTER_MINIO_SECRET
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=studydeck
S3_ACCESS_KEY_ID=studydeck_production_root
S3_SECRET_ACCESS_KEY=REPLACE_WITH_A_UNIQUE_32_PLUS_CHARACTER_MINIO_SECRET
S3_FORCE_PATH_STYLE=true

# Configure the production provider and observability values in the secret
# manager/CI variable store before launch. Do not put real credentials here.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
TAVILY_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Production readiness alerts. Set Telegram values in the secret manager.
ADMIN_ALERTS_ENABLED=false
ADMIN_TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
HEALTH_ALERT_INTERVAL_MS=60000
HEALTH_ALERT_REMINDER_MS=900000
HEALTH_QUEUE_LAG_MAX_AGE_MS=300000
HEALTH_QUEUE_WAITING_MAX=20

# Disaster recovery. Backups are encrypted with the public age recipient before
# leaving the host. The matching private identity is kept only in the recovery
# secret store and is mounted on the host for the restore drill.
BACKUP_ENABLED=true
BACKUP_AGE_RECIPIENT=age1replace_with_the_public_recovery_recipient
BACKUP_AGE_IDENTITY_FILE=/etc/studydeck/backup.agekey
BACKUP_S3_ENDPOINT=https://backups.example.com
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=studydeck-production-backups
BACKUP_S3_ACCESS_KEY_ID=REPLACE_WITH_A_DEDICATED_BACKUP_ACCESS_KEY
BACKUP_S3_SECRET_ACCESS_KEY=REPLACE_WITH_A_UNIQUE_32_PLUS_CHARACTER_BACKUP_SECRET
BACKUP_RETENTION_DAYS=35
BACKUP_OBJECT_LOCK_RETENTION_DAYS=35
BACKUP_RPO_HOURS=24
BACKUP_RTO_HOURS=4
BACKUP_DRILL_MAX_AGE_DAYS=7
OPERATIONS_OWNER=REPLACE_WITH_ON_CALL_OWNER
OPERATIONS_ALERT_CHANNEL=telegram:REPLACE_WITH_INCIDENT_CHAT

# Public legal/support identity. These values are rendered on the public
# privacy, terms, and support pages and are mandatory for production startup.
LEGAL_ENTITY_NAME=REPLACE_WITH_LEGAL_OPERATOR_NAME
SUPPORT_EMAIL=support@example.com
